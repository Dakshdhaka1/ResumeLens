# Copy this file to .env and fill in your keys. Never commit .env.
GEMINI_API_KEY=
# Optional: Claude needs paid credits
ANTHROPIC_API_KEY=
# Free: create at https://console.groq.com/keys (no card needed)
GROQ_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
CLAUDE_MODEL=claude-opus-5-5
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=3
GEMINI_TEMPERATURE=0.2
# Requests per minute your Gemini plan allows (free tier: 5). 0 = no limit.
GEMINI_RPM=5
CLAUDE_EFFORT=low

# 1 = fake model replies (no API calls). Handy for UI work and demos without keys.
RESUMELENS_MOCK=0
